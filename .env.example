# RSS
RSS_FEED_URL=https://barcauniversal.com/feed/
RSS_REQUEST_TIMEOUT=30
RSS_MAX_RETRIES=4
RSS_USER_AGENT=TweegenRSSBot/1.0

# Local state.
# GitHub Actions overrides this to state_repo/logs.
STATE_DIR=logs
LOCAL_TIMEZONE=Asia/Kolkata
MIN_TWEET_GAP_MINUTES=30

# Prompt
TWEET_SYSTEM_PROMPT=
SYSTEM_PROMPT_PATH=prompts/system_prompt.txt

# LLM
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_THINKING_LEVEL=low
GEMINI_TRANSIENT_RETRIES=3

GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GROQ_REASONING_EFFORT=low

LLM_MAX_OUTPUT_TOKENS=800

# Buffer
BUFFER_API_URL=https://api.buffer.com
BUFFER_API_KEY=
BUFFER_CHANNEL_ID=
BUFFER_REQUEST_TIMEOUT=30
